# Réglages du bot. Ce fichier est relu à CHAQUE tour (toutes les minutes) : une modification
# s'applique au tour suivant, sans rien relancer. Format : CLE="valeur". Ne JAMAIS mettre ici
# les clés Capital.com (elles restent dans les secrets GitHub), ni ACTION ou STRATEGIE.
#
# 26/11/2026 : NETTOYAGE (Mathis repart proprement). Ne restent que les stratégies prouvées :
# la Cassure 4 h (or et argent) et la Rapide 5 min (or), avec les garde-fous.
# Tout ce qui a été retiré (Tendance Bitcoin, Élan, Supertrend, usine, Avant la Fed, veille d'actus,
# simulateur, deux cerveaux) est dans la branche GitHub « sauvegarde-26-11 ».

# --- Stratégie 1 : Cassure 4 h (or et argent) ---
CASSURE_MARCHES="GOLD,SILVER"   # marchés de la stratégie cassure 20 bougies 4 h
RISQUE_CASSURE_PCT="3"          # % du capital perdu au maximum par trade (~3 €)
CASSURE_ENTREE="20"             # achat quand la clôture dépasse le plus haut des N dernières bougies
CASSURE_SORTIE="20"             # sortie quand elle repasse de l'autre côté du canal des N bougies
GARDE_CASSURE_APRES_R="1.5"     # dès +1,5 R de gain (1 R = distance du stop de départ)…
GARDE_CASSURE_PCT="50"          # …le stop garanti remonte pour garder 50 % du meilleur gain ("0" = aucun)
CASSURE_REENTREES="non"         # "oui" = rentrer aussi sur une nouvelle cassure pendant une tendance en cours (backtest 10 ans : moins bien)

# --- Stratégie 2 : Rapide 5 min (or) ---
RAPIDE="oui"                    # "oui" ou "non"
RAPIDE_MARCHES="GOLD"           # marchés de la stratégie rapide
RISQUE_RAPIDE_PCT="1"           # % du capital perdu au maximum par trade (~1 €)
SUIVI_RAPIDE_PCT="1"            # stop suiveur à 1 % derrière le prix
GARDE_RAPIDE_APRES_R="1.5"      # dès +1,5 R de gain…
GARDE_RAPIDE_PCT="60"           # …le stop remonte pour garder 60 % du meilleur gain
SORTIE_ENTREE_R="0.5"           # une fois +0,5 R de gain atteint, sortie si le prix revient au prix d'entrée ("0" = aucune)
SORTIE_CONFIRMEE_RAPIDE="3"     # sortie sur croisement inverse seulement s'il dure 3 bougies 5 min ("1" = immédiate)
FILTRE_BOLLINGER="oui"          # n'ouvrir que si les bandes de Bollinger s'élargissent
ADX_RAPIDE_MIN="20"             # n'ouvrir que si l'ADX 5 min dépasse 20 ("0" = pas de filtre)

# --- Empilement : plusieurs positions sur le même marché, une de plus seulement après +1 R ---
EMPILER_MAX="3"           # Cassure 4 h : 3 positions max par marché (1 = pas d'empilement)
EMPILER_RAPIDE="2"        # Rapide 5 min : 2 positions max

# --- Garde-fous (valables pour toutes les stratégies) ---
PERTE_MAX_PCT="50"        # coupe-circuit : plus aucun ordre si -50 % depuis le plus haut du compte
PERTE_JOUR_PCT="15"       # plus de nouvel ordre si -15 % dans la journée
POSITIONS_MAX="14"        # positions ouvertes au maximum (empilement compris)
RISQUE_TOTAL_PCT="35"     # perte maximale si TOUS les stops étaient touchés en même temps
PAUSE_ANNONCES="oui"      # pas de nouvelle position autour des grandes annonces américaines (Fed, emploi, inflation…)
PAUSE_AVANT_MIN="30"      # minutes de pause avant l'annonce
PAUSE_APRES_MIN="60"      # minutes de pause après l'annonce
STOPS_AFFILEE_MAX="3"     # après 3 stops perdants d'affilée (même stratégie, même marché)…
PAUSE_STOPS_H="24"        # …plus de nouvelle position sur ce marché pendant 24 h (positions ouvertes toujours gérées)

# --- Auto-amélioration hebdomadaire (chaque dimanche à 19 h, heure de Paris) ---
# Teste de petites variantes des réglages des stratégies (un seul cran, une seule modification par stratégie)
# et ne garde que celles qui font mieux. Annule tout seul un changement qui fait moins bien la semaine suivante.
# Ne touche JAMAIS au risque ni aux garde-fous.
#   "auto" = applique les changements ; "suggestions" = les écrit dans le Journal sans rien changer ; "non" = arrêt.
AUTO_AMELIORATION="auto"
AUTO_AMELIORATION_DEBUT="2026-11-29"   # avant cette date : suggestions seulement (Mathis a choisi le dimanche 29/11)
