# Réglages du bot. Ce fichier est relu à CHAQUE tour (toutes les 5 min) : une modification
# s'applique au tour suivant, sans rien relancer. Format : CLE="valeur". Ne JAMAIS mettre ici
# les clés Capital.com (elles restent dans les secrets GitHub), ni ACTION ou STRATEGIE.

# --- Stratégie principale : Tendance 4 h sur le Bitcoin ---
MARCHES="BTCUSD"          # marchés de la stratégie 4 h
UNITE="HOUR_4"            # bougies de 4 h (l'unité testée en backtest)
RISQUE_PCT="1"            # % du capital perdu au maximum par trade
TP_PARTIEL_ATR="1"        # moitié de la position avec un TP à 1 × ATR ("0" = pas de TP)

# --- Stratégie rapide (5 min, expérimentale) ---
RAPIDE="oui"              # "oui" ou "non"
RISQUE_RAPIDE_PCT="0.072" # 0,072 % du capital par trade, soit environ 15 € au maximum
SUIVI_RAPIDE_PCT="2"      # stop suiveur à 2 % derrière le prix pour garder les gros gains ("0" = aucun)
FILTRE_BOLLINGER="oui"   # rapide : n'ouvrir que si les bandes de Bollinger s'élargissent ("non" pour couper)

# --- Sous-bots actions et ETF (un par marché) ---
SOUS_BOTS="TSLA,NVDA,AAPL,MSFT,GOOGL,SPY,QQQ,GLD,XLK,IWM"
RISQUE_SOUS_BOT_PCT="0.5" # % du capital perdu au maximum par trade et par sous-bot

# --- Cassure 4 h (or et argent) ---
CASSURE_MARCHES="GOLD,SILVER"   # marchés de la stratégie cassure 20 bougies 4 h
RISQUE_CASSURE_PCT="0.5"        # % du capital perdu au maximum par trade

# --- Cassure 4 h sur tous les autres marchés (analyse du marché avant chaque entrée) ---
CASSURE_TOUS="oui"              # "oui" ou "non"
RISQUE_CASSURE_TOUS_PCT="0.25"  # % du capital perdu au maximum par trade (~52 €)

# --- Petit compte risqué (expérience) : même cassure, sur un capital VIRTUEL ---
PETIT_COMPTE="oui"              # "oui" ou "non"
PETIT_CAPITAL_DEPART="100"      # capital virtuel de départ, en €
PETIT_RISQUE_PCT="10"           # % du capital virtuel risqué par trade (choix de Mathis : 10 €)

# --- Tendance 1 mois (11 marchés, décision chaque jour) ---
TENDANCE_MOIS="oui"             # "oui" ou "non"
TENDANCE_MOIS_MARCHES="AAPL,AMD,AMZN,ARKK,AUDUSD,DE40,EEM,ETHUSD,EURUSD,GBPUSD,GLD,GOLD,GOOGL,IWM,JPM,META,MSFT,NFLX,NVDA,OIL_CRUDE,QQQ,SILVER,SLV,SOLUSD,SPY,TLT,TSLA,US100,US500,USDJPY,VTI,XLE,XLF,XLK"   # 34 marchés (BTC exclu : déjà tradé)
TENDANCE_MOIS_ANALYSE="oui"     # analyser d'abord : ne trader un marché que si la stratégie y a gagné sur 12 mois
RISQUE_TENDANCE_MOIS_PCT="0.3"  # % du capital perdu au maximum par trade et par marché (~63 €)

# --- Objectif x5 sur l'or (loterie, capital VIRTUEL) ---
X5_OR="oui"                     # "oui" ou "non"
X5_CAPITAL_DEPART="50"          # capital virtuel de départ, en €
X5_LEVIER="20"                  # levier maximum Capital.com sur l'or
X5_OBJECTIF_PCT="20"            # prise de bénéfice à +20 % du prix de l'or (≈ x5)
X5_STOP_PCT="2.5"               # stop garanti à -2,5 % du prix (≈ -50 % du capital virtuel)
X5_ARGENT="oui"                 # même essai sur l'argent, 50 € virtuels à part
X5_ARGENT_LEVIER="10"           # levier maximum Capital.com sur l'argent
X5_ARGENT_OBJECTIF_PCT="40"     # +40 % du prix de l'argent (≈ x5)
X5_ARGENT_STOP_PCT="5"          # -5 % du prix (≈ -50 % du capital virtuel)

# --- Garde-fous (valables pour TOUTES les stratégies) ---
PERTE_MAX_PCT="10"        # coupe-circuit : plus aucun ordre si -10 % depuis le plus haut du compte
PERTE_JOUR_PCT="3"        # plus de nouvel ordre si -3 % dans la journée
POSITIONS_MAX="40"        # positions ouvertes au maximum, toutes stratégies confondues
RISQUE_TOTAL_PCT="12"     # perte maximale si TOUS les stops étaient touchés en même temps
PAUSE_ANNONCES="oui"      # pas de nouvelle position autour des grandes annonces américaines (Fed, emploi, inflation…)
PAUSE_AVANT_MIN="30"      # minutes de pause avant l'annonce
PAUSE_APRES_MIN="60"      # minutes de pause après l'annonce
