# Réglages du bot. Ce fichier est relu à CHAQUE tour (toutes les 5 min) : une modification
# s'applique au tour suivant, sans rien relancer. Format : CLE="valeur". Ne JAMAIS mettre ici
# les clés Capital.com (elles restent dans les secrets GitHub), ni ACTION ou STRATEGIE.
#
# 20/11/2026 : Mathis repart simple. 3 stratégies testées 2 semaines en démo sur un compte d'environ
# 100 € : la Tendance 4 h (Bitcoin), la Cassure 4 h (or et argent) et la Rapide 5 min (or et argent).

# --- Stratégie 1 : Tendance 4 h sur le Bitcoin (le premier bot) ---
MARCHES="BTCUSD"          # marchés de la stratégie 4 h
UNITE="HOUR_4"            # bougies de 4 h (l'unité testée en backtest)
RISQUE_PCT="3"            # % du capital perdu au maximum par trade (~3 € sur 100 €)
TP_PARTIEL_ATR="1"        # moitié de la position avec un TP à 1 × ATR ("0" = pas de TP)
ADX_TENDANCE_MIN="20"     # n'entrer que si l'ADX 4 h dépasse cette valeur
SUIVI_TENDANCE_ATR="5"    # stop suiveur à N × ATR derrière le prix

# --- Stratégie 2 : Cassure 4 h (or et argent) ---
CASSURE_MARCHES="GOLD,SILVER"   # marchés de la stratégie cassure 20 bougies 4 h
RISQUE_CASSURE_PCT="3"          # % du capital perdu au maximum par trade (~3 €)
CASSURE_ENTREE="20"             # achat quand la clôture dépasse le plus haut des N dernières bougies
CASSURE_SORTIE="20"             # sortie quand elle repasse de l'autre côté du canal des N bougies
GARDE_CASSURE_APRES_R="1.5"     # 25/11 : dès +1,5 R de gain (1 R = distance du stop de départ)…
GARDE_CASSURE_PCT="50"          # …le stop garanti remonte pour garder 50 % du meilleur gain ("0" = aucun)

# --- Stratégie 3 : Rapide 5 min (or et argent), ajoutée par Mathis au test le 20/11/2026 ---
RAPIDE="oui"                    # "oui" ou "non"
RAPIDE_MARCHES="GOLD"    # marchés de la stratégie rapide
RISQUE_RAPIDE_PCT="1"           # % du capital perdu au maximum par trade (~1 €)
SUIVI_RAPIDE_PCT="1"             # 25/11 : stop suiveur à 1 % derrière le prix (avant 2 %, trop loin pour du 5 min)
GARDE_RAPIDE_APRES_R="1.5"      # 25/11 (choix de Mathis, pour le voir en démo) : dès +1,5 R de gain…
GARDE_RAPIDE_PCT="60"           # …le stop remonte pour garder 60 % du meilleur gain (backtest : un peu moins bien, 9,0 R au lieu de 9,5 R)
SORTIE_ENTREE_R="0.5"           # 25/11 : une fois +0,5 R de gain atteint, sortie si le prix revient au prix d'entrée ("0" = aucune)
SORTIE_CONFIRMEE_RAPIDE="3"     # 25/11 : sortie sur croisement inverse seulement s'il dure 3 bougies 5 min ("1" = immédiate)
FILTRE_BOLLINGER="oui"          # n'ouvrir que si les bandes de Bollinger s'élargissent
ADX_RAPIDE_MIN="20"             # n'ouvrir que si l'ADX 5 min dépasse 20 (tendance assez forte ; "0" = pas de filtre)

# --- Garde-fous (valables pour les deux stratégies, compte d'environ 100 €) ---
# EMPILEMENT (20/11) : jusqu'à 3 positions par marché (Tendance 4 h et Cassure 4 h), une de plus
# seulement quand le prix a avancé d'1 R depuis la dernière entrée. 1 = pas d'empilement.
EMPILER_MAX="3"
EMPILER_RAPIDE="2"        # 25/11 : 2 positions max sur la Rapide (avant 3 ; backtest : quasi pareil, moins de risque en fin de mouvement)

PERTE_MAX_PCT="50"        # coupe-circuit : plus aucun ordre si -50 % depuis le plus haut du compte
PERTE_JOUR_PCT="15"       # plus de nouvel ordre si -15 % dans la journée
POSITIONS_MAX="14"        # positions ouvertes au maximum (empilement compris)
RISQUE_TOTAL_PCT="35"     # perte maximale si TOUS les stops étaient touchés en même temps
PAUSE_ANNONCES="oui"      # pas de nouvelle position autour des grandes annonces américaines (Fed, emploi, inflation…)
PAUSE_AVANT_MIN="30"      # minutes de pause avant l'annonce
PAUSE_APRES_MIN="60"      # minutes de pause après l'annonce
STOPS_AFFILEE_MAX="3"     # après 3 stops perdants d'affilée (même stratégie, même marché)…
PAUSE_STOPS_H="24"        # …plus de nouvelle position sur ce marché pendant 24 h (positions ouvertes toujours gérées)

# --- Deux cerveaux (25/11/2026, idée de Mathis) ---
# Tendance 4 h (Bitcoin) : une NOUVELLE position n'est ouverte que si le 2e cerveau est d'accord
# (note des indicateurs + structure sommets/creux + tendance 1 h, au moins 2 avis sur 3). Moins de trades, plus sûrs.
# Backtest 2 ans : +16,2 R -> +17,4 R, mieux les 2 années, pire baisse -3,7 R -> -2,7 R. "0" = désactivé.
# Pas sur la Cassure or/argent : là, le 2e cerveau enlève de bons trades (backtest/deux_cerveaux.py).
DEUX_CERVEAUX_TENDANCE="1"

# --- Auto-amélioration hebdomadaire (24/11/2026, demande de Mathis) ---
# Chaque dimanche soir, le bot teste de petites variantes des réglages marqués ci-dessus (un seul cran,
# une seule modification par stratégie) et ne garde que celles qui font mieux. Il annule tout seul un
# changement qui fait moins bien la semaine suivante. Il ne touche JAMAIS au risque ni aux garde-fous.
#   "auto" = applique les changements ; "suggestions" = les écrit dans le Journal sans rien changer ; "non" = arrêt.
AUTO_AMELIORATION="auto"
AUTO_AMELIORATION_DEBUT="2026-11-29"   # avant cette date : suggestions seulement. Mathis a choisi de démarrer dès le dimanche 29/11.
# Chaque ordre garde les réglages avec lesquels il a été ouvert : le bilan sépare toujours avant / après un changement.

# --- Élan des gros acteurs 4 h (EXPÉRIMENTALE, 25/11/2026, idée de Mathis) : voir bot/elan.py ---
ELAN="oui"                      # "oui" ou "non"
ELAN_MARCHES="GOLD,SILVER"      # or et argent (sur le Bitcoin, le backtest était faible)
RISQUE_ELAN_PCT="1"             # petit risque : 1 % du capital par trade
TROU_MIN_ATR="0.25"             # taille minimale du « trou » laissé par le gros ordre, en ATR
OBJECTIF_ELAN_R="2"             # objectif (TP) à 2 fois la distance du stop
MAX_BOUGIES_ELAN="20"           # sortie forcée après 20 bougies de 4 h
